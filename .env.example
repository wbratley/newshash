# LLM provider used for synthesis: "anthropic" (default), "nim" or "deepseek"
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=your_api_key_here

# NVIDIA NIM (used when LLM_PROVIDER=nim) — https://integrate.api.nvidia.com/v1
NIM_API_KEY=your_nim_api_key_here
NIM_MODEL=deepseek-ai/deepseek-v4.1-flash

# DeepSeek API (used when LLM_PROVIDER=deepseek) — https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash
# deepseek-flash has thinking on by default; keep it off for the daily digest
DEEPSEEK_THINKING=false
